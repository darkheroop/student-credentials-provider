# Student Credentials Provider - Environment Configuration
# Copy this file to .env and replace placeholder values

# MD5Decrypt API Configuration (Auto-seeded to DB on first boot if DB is empty)
# Get your API key from: https://md5decrypt.net/en/Api/
MD5DECRYPT_API_KEY=replace_with_your_api_key
MD5DECRYPT_API_URL=https://api.md5decrypt.net/

# Student Lookup Operating Mode: 'demo' or 'live'
# demo = Uses synthetic local student record data (no API key required)
# live = Uses the external provider API with automatic failover
STUDENT_LOOKUP_MODE=live

# Request timeout in seconds for external provider calls
STUDENT_LOOKUP_TIMEOUT_SECONDS=10

# Dynamic Failover Configuration
MAX_FAILOVER_ATTEMPTS=5
DEFAULT_PAUSE_DURATION_MINUTES=60
DATABASE_PATH=scp.db

# API Key Encryption at Rest
API_ENCRYPTION_KEY=change-this-to-a-secure-32char-encryption-key!

# Administrator Credentials for API Management (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password

# Rate limiting: max requests per minute per client IP
RATE_LIMIT_PER_MINUTE=30

# Flask configuration
FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=change-this-to-a-random-secret-key
